sort Pid = Nat;
sort MessageData = Nat;
sort Message = struct Message(senderID: Pid, receiverID: Pid, message: MessageData);

map LOSSY_NETWORK : Bool;
eqn LOSSY_NETWORK = false;

map ALLOW_CRASH : Bool;
eqn ALLOW_CRASH = false;

map NETWORK_LIMIT : Nat;
eqn NETWORK_LIMIT = 20;

map MakeMessage: Nat -> MessageData;
var msg: Nat;
eqn MakeMessage(msg) = msg;

map Node_PID : List(Pid);
eqn Node_PID = [1001, 1002, 1003];


map SplitBroadcastedMessages: Pid # List(Pid) # MessageData -> List(Message);
var v_sender: Pid;
  v_receivers: List(Pid);
    v_message: MessageData;
eqn SplitBroadcastedMessages(v_sender, v_receivers, v_message) =
    SplitBroadcastedMessagesHelper(v_sender, v_receivers, v_message, []);
map SplitBroadcastedMessagesHelper: Pid # List(Pid) # MessageData # List(Message) -> List(Message);
var v_sender: Pid;
    v_receivers: List(Pid);
    v_message: MessageData;
    v_msgs: List(Message);
eqn ((# v_receivers) == 0) 
        -> SplitBroadcastedMessagesHelper(v_sender, v_receivers, v_message, v_msgs) 
        = v_msgs;
    ((# v_receivers) > 0 && head(v_receivers) == v_sender)  
        -> SplitBroadcastedMessagesHelper(v_sender, v_receivers, v_message, v_msgs) 
        = SplitBroadcastedMessagesHelper(v_sender, tail(v_receivers), v_message, v_msgs);
    ((# v_receivers) > 0 && head(v_receivers) != v_sender)  
        -> SplitBroadcastedMessagesHelper(v_sender, v_receivers, v_message, v_msgs) 
        = SplitBroadcastedMessagesHelper(v_sender, tail(v_receivers), v_message, v_msgs
              <| Message(v_sender, head(v_receivers), v_message));


act
  sendMessage, receiveMessage, networkReceiveMessage, networkSendMessage, outgoingMessage, incomingMessage, canReceiveAMessage, exposeNextMessage, canReceiveNextMessage: Pid # Pid # MessageData;
  broadcastMessages, networkBroadcastMessages, broadcast: Pid # List(Pid) # MessageData;
  lose, done, fail, emptyNetwork, protocolDone;
  resume, crash, timeout: Pid;
  failedToElect; exposeLeader : Nat;
proc
  Node(pid: Pid, all_nodes: List(Pid)) = 
    Node_idle(pid, all_nodes, false)
  ;
  Node_idle(pid: Pid, all_nodes: List(Pid), voted: Bool) = 
    (sum msg : MessageData . sum pid2 : Pid . canReceiveAMessage (pid , pid2 , msg) .
      Node_idle_ReceiveMessages(pid, all_nodes, voted))
    + timeout(pid) . 
      ((voted == false) -> (
        broadcastMessages(pid, all_nodes, MakeMessage(4))
        .
        Node_candidate(pid, all_nodes, # (all_nodes) - 1, ceil((# (all_nodes) / 2)) - 1)
      ) <> (
        Node_idle(pid, all_nodes, voted)
      ))
    + (ALLOW_CRASH) -> crash(pid) . Node_idle_Crashed(pid, all_nodes, voted);

  Node_idle_ReceiveMessages(pid: Pid, all_nodes: List(Pid), voted: Bool) = 
    (sum candidate : Pid . sum m : MessageData . (
      (m == 4) -> (receiveMessage(pid, candidate, m) . 
        ((voted == false) -> (
          sendMessage(pid, candidate, MakeMessage(1))
          .
          Node_idle(pid, all_nodes, true)
        ) <> (
          sendMessage(pid, candidate, MakeMessage(0))
          .
          Node_idle(pid, all_nodes, true)
        ))
      )
    ))
    +
    (sum candidate : Pid . sum m : MessageData . (
      (m == 5) -> (receiveMessage(pid, candidate, m) . 
        protocolDone
      )
    ))
  ;

  Node_idle_Crashed(pid: Pid, all_nodes: List(Pid), voted: Bool) = 
    (sum server : Pid . sum m : MessageData . receiveMessage(pid, server, m)) . Node_idle_Crashed(pid, all_nodes, voted)
    + resume(pid) . Node_idle(pid, all_nodes, voted)
  ;

  Node_candidate(pid: Pid, all_nodes: List(Pid), remaining_messages: Int, approves_needed: Int) = 
    (sum msg : MessageData . sum pid2 : Pid . canReceiveAMessage (pid , pid2 , msg) .
      Node_candidate_ReceiveMessages(pid, all_nodes, remaining_messages, approves_needed))
    + (ALLOW_CRASH) -> crash(pid) . Node_candidate_Crashed(pid, all_nodes, remaining_messages, approves_needed);

  Node_candidate_ReceiveMessages(pid: Pid, all_nodes: List(Pid), remaining_messages: Int, approves_needed: Int) = 
    (sum some_user : Pid . sum m : MessageData . (
      (((m == 1 || m == 0) && remaining_messages > 1)) -> (receiveMessage(pid, some_user, m) . 
        Node_candidate(pid, all_nodes, remaining_messages - 1, approves_needed - m)
      )
    ))
    +
    (sum some_user : Pid . sum m : MessageData . (
      (((m == 1 || m == 0) && remaining_messages == 1)) -> (receiveMessage(pid, some_user, m) . 
        ((approves_needed - m <= 0) -> (
          broadcastMessages(pid, all_nodes, MakeMessage(5))
          .
          protocolDone
        ) <> (
          failedToElect
          .
          Node_candidate(pid, all_nodes, remaining_messages - 1, 99)
        ))
      )
    ))
    +
    (sum candidate : Pid . sum m : MessageData . (
      (m == 4) -> (receiveMessage(pid, candidate, m) . 
        sendMessage(pid, candidate, MakeMessage(0))
        .
        Node_candidate(pid, all_nodes, remaining_messages, approves_needed)
      )
    ))
    
  ;

  Node_candidate_Crashed(pid: Pid, all_nodes: List(Pid), remaining_messages: Int, approves_needed: Int) = 
    (sum server : Pid . sum m : MessageData . receiveMessage(pid, server, m)) . Node_candidate_Crashed(pid, all_nodes, remaining_messages, approves_needed)
    + resume(pid) . Node_candidate(pid, all_nodes, remaining_messages, approves_needed)
  ;
  Network(msgs: List(Message)) =
  (sum sender : Pid, msg: MessageData . ((# msgs) < NETWORK_LIMIT) -> (
    (sum receiver : Pid .
      networkReceiveMessage(sender, receiver, msg) .
      Network(msgs = msgs <| Message(sender, receiver, msg))
    )
    +
    (sum receivers: List(Pid) .
      networkBroadcastMessages(sender, receivers, msg) .
      Network(msgs = msgs ++ SplitBroadcastedMessages(sender, receivers, msg)))
   ))
   +
    ((# msgs) > 0) -> (
      (exposeNextMessage(receiverID(head(msgs)), senderID(head(msgs)), message(head(msgs))) .
          networkSendMessage(receiverID(head(msgs)), senderID(head(msgs)), message(head(msgs))))
      + ((LOSSY_NETWORK) -> lose)
    ) . Network(msgs = tail(msgs))
   + ((# msgs) == 0) -> (emptyNetwork . Network());
init
  allow({outgoingMessage, incomingMessage, broadcast, lose, done, fail, timeout, resume, crash, canReceiveNextMessage, failedToElect, exposeLeader},
  comm({
    sendMessage|networkReceiveMessage -> outgoingMessage
    ,canReceiveAMessage|exposeNextMessage -> canReceiveNextMessage
    ,networkSendMessage|receiveMessage -> incomingMessage
    ,broadcastMessages|networkBroadcastMessages -> broadcast
    ,protocolDone|protocolDone|protocolDone -> done
  },
    Node(Node_PID . 0, Node_PID) || Node(Node_PID . 1, Node_PID) || Node(Node_PID . 2, Node_PID) || Network([])
  )
);
