sort Pid = Nat;
sort MessageData = Nat;
sort Message = struct Message(senderID: Pid, receiverID: Pid, message: MessageData);

map LOSSY_NETWORK : Bool;
eqn LOSSY_NETWORK = false;

map ALLOW_CRASH : Bool;
eqn ALLOW_CRASH = false;

map NETWORK_LIMIT : Nat;
eqn NETWORK_LIMIT = 20;

map MakeMessage: Nat -> MessageData;
var msg: Nat;
eqn MakeMessage(msg) = msg;

map DemoNode_PID : List(Pid);
eqn DemoNode_PID = [1001, 1002, 1003];


map SplitBroadcastedMessages: Pid # List(Pid) # MessageData -> List(Message);
var v_sender: Pid;
  v_receivers: List(Pid);
    v_message: MessageData;
eqn SplitBroadcastedMessages(v_sender, v_receivers, v_message) =
    SplitBroadcastedMessagesHelper(v_sender, v_receivers, v_message, []);
map SplitBroadcastedMessagesHelper: Pid # List(Pid) # MessageData # List(Message) -> List(Message);
var v_sender: Pid;
    v_receivers: List(Pid);
    v_message: MessageData;
    v_msgs: List(Message);
eqn ((# v_receivers) == 0) 
        -> SplitBroadcastedMessagesHelper(v_sender, v_receivers, v_message, v_msgs) 
        = v_msgs;
    ((# v_receivers) > 0 && head(v_receivers) == v_sender)  
        -> SplitBroadcastedMessagesHelper(v_sender, v_receivers, v_message, v_msgs) 
        = SplitBroadcastedMessagesHelper(v_sender, tail(v_receivers), v_message, v_msgs);
    ((# v_receivers) > 0 && head(v_receivers) != v_sender)  
        -> SplitBroadcastedMessagesHelper(v_sender, v_receivers, v_message, v_msgs) 
        = SplitBroadcastedMessagesHelper(v_sender, tail(v_receivers), v_message, v_msgs
              <| Message(v_sender, head(v_receivers), v_message));


act
  sendMessage, receiveMessage, networkReceiveMessage, networkSendMessage, outgoingMessage, incomingMessage, canReceiveAMessage, exposeNextMessage, canReceiveNextMessage: Pid # Pid # MessageData;
  broadcastMessages, networkBroadcastMessages, broadcast: Pid # List(Pid) # MessageData;
  lose, done, fail, emptyNetwork, protocolDone;
  resume, crash, timeout: Pid;
  electedAsLeader; failedToElect;
proc
  DemoNode(pid: Pid, all_nodes: List(Pid)) = 
    DemoNode_idle(pid, all_nodes, false)
  ;
  DemoNode_idle(pid: Pid, all_nodes: List(Pid), voted: Bool) = 
    (sum msg : MessageData . sum pid2 : Pid . canReceiveAMessage (pid , pid2 , msg) .
      DemoNode_idle_ReceiveMessages(pid, all_nodes, voted))
    + timeout(pid) . 
      ((voted == false) -> (
        broadcastMessages(pid, all_nodes, MakeMessage(11))
        .
        DemoNode_candidate(pid, all_nodes, ceil((# (all_nodes) / 2)) - 1, # (all_nodes) - 1)
      ) <> (
        DemoNode_idle(pid, all_nodes, voted)
      ))
    + (ALLOW_CRASH) -> crash(pid) . DemoNode_idle_Crashed(pid, all_nodes, voted);

  DemoNode_idle_ReceiveMessages(pid: Pid, all_nodes: List(Pid), voted: Bool) = 
    (sum from : Pid . sum msg : MessageData . (
      (msg == 11) -> (receiveMessage(pid, from, msg) . 
        ((voted == false) -> (
          sendMessage(pid, from, MakeMessage(1))
          .
          DemoNode_idle(pid, all_nodes, true)
        ) <> (
          sendMessage(pid, from, MakeMessage(0))
          .
          DemoNode_idle(pid, all_nodes, voted)
        ))
      )
    ))
    +
    (sum candidate : Pid . sum msg : MessageData . (
      (msg == 12) -> (receiveMessage(pid, candidate, msg) . 
        protocolDone
      )
    ))
  ;

  DemoNode_idle_Crashed(pid: Pid, all_nodes: List(Pid), voted: Bool) = 
    (sum server : Pid . sum m : MessageData . receiveMessage(pid, server, m)) . DemoNode_idle_Crashed(pid, all_nodes, voted)
    + resume(pid) . DemoNode_idle(pid, all_nodes, voted)
  ;

  DemoNode_candidate(pid: Pid, all_nodes: List(Pid), approves_needed: Int, remaining_messages: Int) = 
    (sum msg : MessageData . sum pid2 : Pid . canReceiveAMessage (pid , pid2 , msg) .
      DemoNode_candidate_ReceiveMessages(pid, all_nodes, approves_needed, remaining_messages))
    + (ALLOW_CRASH) -> crash(pid) . DemoNode_candidate_Crashed(pid, all_nodes, approves_needed, remaining_messages);

  DemoNode_candidate_ReceiveMessages(pid: Pid, all_nodes: List(Pid), approves_needed: Int, remaining_messages: Int) = 
    (sum some_user : Pid . sum msg : MessageData . (
      (((msg == 1 || msg == 0) && remaining_messages > 1)) -> (receiveMessage(pid, some_user, msg) . 
        DemoNode_candidate(pid, all_nodes, approves_needed - msg, remaining_messages - 1)
      )
    ))
    +
    (sum some_user : Pid . sum msg : MessageData . (
      (((msg == 1 || msg == 0) && remaining_messages == 1)) -> (receiveMessage(pid, some_user, msg) . 
        ((approves_needed - msg <= 0) -> (
          broadcastMessages(pid, all_nodes, MakeMessage(12))
          .
          electedAsLeader
          .
          protocolDone
        ) <> (
          failedToElect
          .
          DemoNode_candidate(pid, all_nodes, 99, remaining_messages - 1)
        ))
      )
    ))
    +
    (sum candidate : Pid . sum msg : MessageData . (
      (msg == 11) -> (receiveMessage(pid, candidate, msg) . 
        sendMessage(pid, candidate, MakeMessage(0))
        .
        DemoNode_candidate(pid, all_nodes, approves_needed, remaining_messages)
      )
    ))
  ;

  DemoNode_candidate_Crashed(pid: Pid, all_nodes: List(Pid), approves_needed: Int, remaining_messages: Int) = 
    (sum server : Pid . sum m : MessageData . receiveMessage(pid, server, m)) . DemoNode_candidate_Crashed(pid, all_nodes, approves_needed, remaining_messages)
    + resume(pid) . DemoNode_candidate(pid, all_nodes, approves_needed, remaining_messages)
  ;
  Network(msgs: List(Message)) =
  (sum sender : Pid, msg: MessageData . ((# msgs) < NETWORK_LIMIT) -> (
    (sum receiver : Pid .
      networkReceiveMessage(sender, receiver, msg) .
      Network(msgs = msgs <| Message(sender, receiver, msg))
    )
    +
    (sum receivers: List(Pid) .
      networkBroadcastMessages(sender, receivers, msg) .
      Network(msgs = msgs ++ SplitBroadcastedMessages(sender, receivers, msg)))
   ))
   +
    ((# msgs) > 0) -> (
      (exposeNextMessage(receiverID(head(msgs)), senderID(head(msgs)), message(head(msgs))) .
          networkSendMessage(receiverID(head(msgs)), senderID(head(msgs)), message(head(msgs))))
      + ((LOSSY_NETWORK) -> lose)
    ) . Network(msgs = tail(msgs))
   + ((# msgs) == 0) -> (emptyNetwork . Network());
init
  allow({outgoingMessage, incomingMessage, broadcast, lose, done, fail, timeout, resume, crash, canReceiveNextMessage, electedAsLeader, failedToElect},
  comm({
    sendMessage|networkReceiveMessage -> outgoingMessage
    ,canReceiveAMessage|exposeNextMessage -> canReceiveNextMessage
    ,networkSendMessage|receiveMessage -> incomingMessage
    ,broadcastMessages|networkBroadcastMessages -> broadcast
    ,protocolDone|protocolDone|protocolDone -> done
    
  },
    DemoNode(DemoNode_PID . 0, DemoNode_PID) || DemoNode(DemoNode_PID . 1, DemoNode_PID) || DemoNode(DemoNode_PID . 2, DemoNode_PID) || Network([])
  )
);
